# Verified Code Factory (VCF) Environment Configuration
# Copy this file to .env and fill in your actual API keys.
# IMPORTANT: Never commit a real .env file with actual secrets.

# ============================================================================
# OpenRouter Configuration (Recommended for smoke testing)
# ============================================================================
# Using OpenRouter's Gemini 2.5 Flash Lite (free tier with rate limits)

OPENROUTER_API_KEY=your-openrouter-api-key
VCF_API_PROVIDER=default
VCF_ARCHITECT_MODEL=openrouter/google/gemini-2.5-flash-lite
VCF_REFEREE_MODEL=openrouter/google/gemini-2.5-flash-lite
VCF_REQUEST_TIMEOUT=60

# ============================================================================
# VCF Core Configuration
# ============================================================================

# Maximum characters to load from PROJECT_CONTEXT.md or docs/MEMORY.md
VCF_CONTEXT_MAX_CHARS=6000

# Directory where approved prompts and review diagnostics are written
VCF_ZED_DIR=.zed

# ============================================================================
# Alternative: AgentRouter Gateway (Optional)
# ============================================================================
# Uncomment this block and comment out the OpenRouter section above
# to route VCF through AgentRouter instead.

# VCF_API_PROVIDER=agentrouter
# AGENTROUTER_API_KEY=your-agentrouter-api-key
# VCF_API_BASE=https://agentrouter.org/v1
# VCF_ARCHITECT_MODEL=gpt-4o-mini
# VCF_REFEREE_MODEL=gpt-4o-mini
# VCF_REQUEST_TIMEOUT=60

# ============================================================================
# Alternative: OpenAI Direct (Optional)
# ============================================================================
# Uncomment this block and comment out other sections to use OpenAI directly.

# OPENAI_API_KEY=sk-your-key
# VCF_API_PROVIDER=default
# VCF_ARCHITECT_MODEL=gpt-4o-mini
# VCF_REFEREE_MODEL=gpt-4o-mini
# VCF_REQUEST_TIMEOUT=60

# ============================================================================
# Alternative: Anthropic Claude (Optional)
# ============================================================================
# Uncomment this block and comment out other sections to use Anthropic.

# ANTHROPIC_API_KEY=sk-your-key
# VCF_API_PROVIDER=default
# VCF_ARCHITECT_MODEL=claude-3-5-sonnet
# VCF_REFEREE_MODEL=claude-3-5-sonnet
# VCF_REQUEST_TIMEOUT=60

# ============================================================================
# Alternative: Local Ollama (Optional)
# ============================================================================
# Uncomment this block to use a locally running Ollama instance.

# VCF_API_PROVIDER=default
# VCF_ARCHITECT_MODEL=ollama/llama3
# VCF_REFEREE_MODEL=ollama/llama3
# VCF_REQUEST_TIMEOUT=60
